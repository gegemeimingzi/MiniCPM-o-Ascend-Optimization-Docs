+                "code": "BATCH_CORE_FRAME_TOO_FEW",
+                "actual": n_core,
+                "minimum": int(min_core_frames),
+            }
+        )
+
+    return {
+        **pooled,
+        "batch_id": batch_id,
+        "batch_core_rtf": batch_core_rtf,
+        "batch_validity": {
