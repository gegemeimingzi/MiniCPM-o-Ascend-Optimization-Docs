@@ -0,0 +1,144 @@
+#!/usr/bin/env python3
+"""æŠŠè§†é¢‘åˆ‡æˆé¢„åˆ‡åˆ† test case ç›®å½•ï¼Œä¾› RTS è‡ªæµ‹ä½¿ç”¨ã€‚
+
+æ­£å¼è¯„æµ‹çš„ RTS è¾“å…¥æ˜¯é¢„åˆ‡åˆ†å¥½çš„ 1 ç§’ WAV/JPGï¼Œä¸åœ¨è¯„æµ‹æ—¶é‡æ–°è§£ç  MP4 â€”â€” è§£ç 
+è€—æ—¶å’Œå¸§æå–æŠ–åŠ¨ä¼šæ··è¿›é€Ÿåº¦æˆç»©é‡Œã€‚æœ¬è„šæœ¬ç”¨ä¸æ­£å¼è¯„æµ‹ç›¸åŒçš„åˆ‡åˆ†å‚æ•°äº§å‡ºåŒæ ·å¸ƒå±€
+çš„ç›®å½•ï¼Œè®©è‡ªæµ‹èµ°çš„æ˜¯å’Œçº¿ä¸Šå®Œå…¨ä¸€æ ·çš„é‚£æ¡è¯»å–è·¯å¾„ã€‚
+
+è¾“å‡ºå¸ƒå±€ï¼ˆRTS_TEST_CASE_DIR æŒ‡å‘ --out-dir å³å¯ï¼‰ï¼š
+
+    <out-dir>/<è§†é¢‘å>_test_case/<è§†é¢‘å>_test_case_0000.wav
+                                <è§†é¢‘å>_test_case_0000.jpg
+                                ...
+
+WAV ä¸º 16kHz å•å£°é“ 16-bitï¼Œæ¯ä¸ª 1 ç§’ï¼›JPG ä¸ºè¯¥ç§’ä¸­ç‚¹æŠ½çš„ä¸€å¸§ã€‚
+"""
+
+from __future__ import annotations
+
+import argparse
+import subprocess
+import sys
+from pathlib import Path
+from typing import Optional
+
+import numpy as np
+import soundfile as sf
+
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+
+from duplex_video_chunker import VideoChunkerConfig, extract_av_chunks  # noqa: E402
+
+SAMPLE_RATE = 16000
+
+
+def _to_pcm16(audio: np.ndarray) -> np.ndarray:
+    """float32 â†’ int16ã€‚
+
+    æ˜¾å¼æˆªæ–­è€Œä¸æ˜¯äº¤ç»™ libsndfileï¼šä¸¤ç§å–æ•´æ–¹å¼ä¼šå·® 1 ä¸ª LSBï¼Œå†™æ­»åœ¨è¿™é‡Œæ‰èƒ½ä¿è¯
+    ä»»ä½•æœºå™¨ä¸Šåˆ‡å‡ºæ¥çš„æ ·æœ¬å®Œå…¨ä¸€è‡´ã€‚
+    """
+    clipped = np.clip(np.asarray(audio, dtype=np.float32), -1.0, 1.0)
+    return np.trunc(clipped * 32767.0).astype(np.int16)
+
+
+def _probe_duration_s(video: Path) -> Optional[float]:
+    try:
+        out = subprocess.run(
+            [
+                "ffprobe", "-v", "error",
+                "-show_entries", "format=duration",
+                "-of", "default=noprint_wrappers=1:nokey=1",
+                str(video),
+            ],
+            capture_output=True, text=True, check=True,
+        ).stdout.strip()
+        return float(out)
+    except Exception:
+        return None
+
+
+def make_one(video: Path, out_root: Path, max_duration_s: float) -> Path:
+    cfg = VideoChunkerConfig(
+        max_duration_s=max_duration_s,
+        # test case ç›®å½•åªå­˜çœŸå®å†…å®¹ï¼Œå‰åé™éŸ³ padding ç”± runner æŒ‰
+        # RTS_PAD_BEFORE / RTS_PAD_AFTER åœ¨å‘é€æ—¶è¡¥ï¼Œä¸å†™è¿›æ•°æ®ã€‚
+        pad_before_s=0,
+        pad_after_s=0,
+    )
+    audio_chunks, jpegs = extract_av_chunks(video, cfg)
+    if len(audio_chunks) != len(jpegs):
+        raise RuntimeError(
+            f"éŸ³ç”» chunk æ•°ä¸ä¸€è‡´: {len(audio_chunks)} vs {len(jpegs)} ({video})"
+        )
+
+    # æŠ½å¸§ä¸­é€”å¤±è´¥æ—¶åˆ‡åˆ†å™¨åªä¼šåœåœ¨é‚£é‡Œï¼Œå–éŸ³ç”»ä¸¤è¾¹çš„è¾ƒå°å€¼ç»§ç»­ï¼Œä¸æŠ¥é”™ â€”â€” æœºå™¨å¿™çš„
+    # æ—¶å€™çœŸçš„ä¼šå‘ç”Ÿã€‚è¿™æ ·åˆ‡å‡ºæ¥çš„æ˜¯ä¸ªçŸ­ä¸€æˆªçš„æ•°æ®é›†ï¼Œè·‘èµ·æ¥ä¸€åˆ‡æ­£å¸¸ï¼Œåªæ˜¯è¯„çš„ä¸œè¥¿
+    # å°‘äº†ã€‚æ‰€ä»¥è¿™é‡Œæ‹¿è§†é¢‘æ—¶é•¿å…œä¸€é“ï¼Œå®å¯æŠ¥é”™ä¹Ÿä¸è¦å†™å‡ºæ®‹ç¼ºè¾“å…¥ã€‚
+    duration_s = _probe_duration_s(video)
+    if duration_s is not None:
+        expected = int(min(duration_s, max_duration_s))
+        if len(audio_chunks) < expected - 1:
+            raise RuntimeError(
+                f"{video.name} åªåˆ‡å‡º {len(audio_chunks)} ä¸ª chunkï¼ŒæŒ‰ "
+                f"{duration_s:.1f}s æ—¶é•¿åº”æœ‰ {expected} ä¸ªã€‚å¤šåŠæ˜¯ ffmpeg æŠ½å¸§ä¸­é€”"
+                f"å¤±è´¥ï¼ˆæœºå™¨è´Ÿè½½é«˜æ—¶ä¼šå¶å‘ï¼‰ï¼Œé‡è·‘ä¸€æ¬¡å³å¯"
+            )
+
+    stem = video.stem
+    out_dir = out_root / f"{stem}_test_case"
+    out_dir.mkdir(parents=True, exist_ok=True)
+    for old in out_dir.glob(f"{stem}_test_case_*"):
+        old.unlink()
+
+    for i, (audio, jpeg) in enumerate(zip(audio_chunks, jpegs)):
+        base = out_dir / f"{stem}_test_case_{i:04d}"
+        sf.write(
+            str(base.with_suffix(".wav")),
+            _to_pcm16(audio),
+            SAMPLE_RATE,
+            subtype="PCM_16",
+        )
+        base.with_suffix(".jpg").write_bytes(jpeg)
+
+    print(f"[make_test_case] {video.name} -> {out_dir}  chunks={len(audio_chunks)}")
+    return out_dir
+
