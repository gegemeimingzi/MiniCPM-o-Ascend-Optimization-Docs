commit 9f0003ef7c808b4a86e31bba956eed5eec9b2ee1
Author: omni-bench <omni-bench@local>
Date:   Wed Aug 19 12:08:49 2026 +0000

    vision: parallelize image normalize with OpenMP (preprocess 4.9→3.6ms)
    
    normalize_image_u8_to_f32 是 607K 次逐像素 (u8/255-mean)/std 串行循环（~1ms），
    与 resize 相同模式：逐像素独立 → OpenMP 并行（≤64 线程，数学逐位不变零质量风险）。
    实测：preprocess 4.9→3.56ms（-27%），image-encoded 107.9→105.0ms（-2.7%）。
    冒烟验证：videomme/daily-omni 正常，TTS WER 3.463%/SIM 0.738 与改动前一致。
    
    Signed-off-by: omni-bench <omni-bench@local>

diff --git a/tools/omni/vision.cpp b/tools/omni/vision.cpp
index e0d5580..b7c181b 100644
--- a/tools/omni/vision.cpp
+++ b/tools/omni/vision.cpp
@@ -1663,7 +1663,11 @@ static void normalize_image_u8_to_f32(const vision_image_u8 & src, vision_image_
     dst.ny = src.ny;
     dst.buf.resize(src.buf.size());
 
-    // TODO @ngxson : seems like this could be done more efficiently on cgraph
+    // 🔧 [并行] 逐像素独立，OpenMP 并行化（数学逐像素不变，零质量影响）。
+    // 607K 次 (u8/255-mean)/std 串行 ~1ms → 并行后 ~0.2ms
+#ifdef _OPENMP
+    #pragma omp parallel for schedule(static) num_threads(omp_get_max_threads() < 64 ? omp_get_max_threads() : 64)
+#endif
     for (size_t i = 0; i < src.buf.size(); ++i) {
         int c = i % 3; // rgb
         dst.buf[i] = (static_cast<float>(src.buf[i]) / 255.0f - mean[c]) / std[c];
