# 910C 配置（RTS 优化测试版）
MODEL_DIR=/workspace/competition/models/MiniCPM-o-4_5-gguf
MODEL_LLM=${MODEL_DIR}/MiniCPM-o-4_5-F16.gguf
RTS_MODEL_LLM=${MODEL_DIR}/MiniCPM-o-4_5-F16.gguf
TTS_MODEL_PATH=${MODEL_DIR}/tts/MiniCPM-o-4_5-tts-F16.gguf
LLAMACPP_ROOT=/workspace/competition/llama.cpp-omni
EVAL_BIN_DIR=${LLAMACPP_ROOT}/build-prof/bin
OMNI_SERVER_BIN=${LLAMACPP_ROOT}/build-prof/bin/llama-omni-server
# [Sprint16] TTS FlashAttention 在双工 server 路径破坏流式（8 SPEAK/4轮 vs 27/5轮）→ RTS 固定 FA off；FA 精度中性（Sprint5）
OMNI_TTS_HEADCODE_NPU=1
OMNI_T2M_SKIP_REDUNDANT_CONT=ADD_MUL
OMNI_TTS_FLASH_ATTN=0
ASCEND_ENV=/usr/local/Ascend/ascend-toolkit/set_env.sh
DEVICE_ENV_VAR=ASCEND_RT_VISIBLE_DEVICES
DEVICE_IDS=0
DEVICE_COUNT=1
RTS_DEVICE_ID=0
EVAL_SEED=42
CTX_SIZE=40960
GGML_CANN_WEIGHT_NZ=off
GGML_CANN_ACL_GRAPH=off
CPP_NGL=999
T2W_DEVICE=gpu:0
TTS_DEVICE=cpu
RTS_VIDEO=${LLAMACPP_ROOT}/evaluation/judge-final/assets/video/omni_duplex1.mp4
# 评测数据（共享盘，稍后补充精度任务）
GGML_CANN_FUSE_QKV=1
ONNX_MODEL_DIR=/workspace/competition/appendix/Step-Audio-2-mini/token2wav
EVAL_META_PATH=/workspace/competition/appendix/seedtts_testset_zh/meta.lst
EVAL_DATA_PATH=/workspace/competition/appendix/seedtts_testset_zh
PARAFORMER_MODEL=/root/.cache/modelscope/models/iic--speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-pytorch
SPEAKER_CKPT=/workspace/competition/appendix/wavlm_large_finetune.pth
S3PRL_REPO=/workspace/competition/s3prl
